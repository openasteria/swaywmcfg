
### ── Variables ──────────────────────────────
set $mod Mod4
set $term foot
set $menu ~/.local/bin/dmenu-launcher

### ── Appearance ─────────────────────────────

# Remove all Sway window decorations
default_border none
default_floating_border none

# Apply to existing app classes and future windows
for_window [app_id=".*"] border none
for_window [class=".*"] border none


gaps inner 4
gaps outer 8
smart_gaps off
smart_borders off

# Brightness control
bindsym XF86MonBrightnessUp exec brightnessctl --device=amdgpu_bl0 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl --device=amdgpu_bl0 set 5%-

### ── Dark colors ────────────────────────────
client.focused          #292e39 #292e39 #d9dce5 #a6b8ff #292e39
client.focused_inactive #191c23 #191c23 #777f90 #191c23 #191c23
client.unfocused        #111318 #111318 #777f90 #111318 #111318
client.urgent           #ff5555 #ff5555 #ffffff #ff5555 #ff5555
client.placeholder      #111318 #111318 #d9dce5 #111318 #111318
client.background       #111318

### ── Terminal and launcher ──────────────────
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu

# Screenshots
bindsym Print exec ~/.local/bin/screenshot
bindsym $mod+S exec ~/.local/bin/screenshot area
### ── Close and reload ───────────────────────
bindsym $mod+shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Escape exec swaymsg exit
bindsym $mod+w exec wofi --show drun --conf ~/.config/wofi/config --style ~/.config/wofi/style.css
bindsym $mod+t exec ghostty 
### ── Focus windows ──────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

### ── Move windows ───────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### ── Layout ─────────────────────────────────
bindsym $mod+e layout toggle split
bindsym $mod+v splitv
bindsym $mod+b splith
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

### ── Workspaces ─────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

### ── Mouse ──────────────────────────────────
floating_modifier $mod normal

### ── Autostart ──────────────────────────────
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK

input type:keyboard {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}

# Startup
exec waybar -c ~/.config/waybar/config -s ~/.config/waybar/style.css
exec swaybg -i ~/Downloads/wallpaper.jpeg -m fill
